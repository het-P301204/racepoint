{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "RACEPOINT Web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "apps/web"],
      "port": 5173
    },
    {
      "name": "RACEPOINT API",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "main:app", "--reload", "--port", "8000", "--app-dir", "apps/api"],
      "port": 8000
    }
  ]
}
